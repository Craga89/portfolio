---
// The plain CV: one page, built to print (and printed to cv.pdf at build). Its look is its own,
// paper-like, in the site's saved theme on screen and always light on paper.
import { url } from '../lib/url';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Job from '../components/cv/Job.astro';
import Meta from '../components/cv/Meta.astro';
import Icon from '../components/Icon.astro';
import Toggletip from '../components/page/Toggletip.astro';
import { inlineMd } from '../lib/inline-md';
import { CV_DESC, EMAIL, GITHUB, LINKEDIN, NAME, SITE } from '../site';

const cv = await getEntry('sections', 'cv');
if (!cv) throw new Error('src/content/sections/cv.mdx is missing');
const { Content } = await render(cv);
const { role, call } = cv.data as { role: string; call: string };
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title={`CV · ${NAME}, Head of Engineering`} description={CV_DESC} path="cv/" chrome="cv">
  <link slot="head" rel="alternate" type="application/json" href={url('/cv.json')} title="CV (JSON Resume)" />
  <div class="cv">
    <div class="bar noprint">
      <a href={url('/')}>← craigthompson.dev</a>
      <span class="tools">
        <a class="btn alt" href={url('/cv.pdf')} download="Craig-Thompson-CV.pdf">Download PDF</a>
        <button type="button" class="btn" data-print>Print</button>
        <button type="button" class="btn alt" data-palette aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" title="Search and jump (Ctrl+K)">Search</button>
        <span data-lang hidden><select class="lang" data-tr-menu aria-label="Language" title="Language" translate="no"></select></span>
        <button type="button" class="btn alt theme" data-theme-toggle>
          <span class="when-dark"><Icon name="sun" size={18} /><span class="c-sr">Switch to light theme</span></span>
          <span class="when-light"><Icon name="moon" size={18} /><span class="c-sr">Switch to dark theme</span></span>
        </button>
      </span>
    </div>
    <main class="page">
      <header>
        <h1>{NAME}</h1>
        <p class="role">{role}</p>
        <p class="contact">
          Newcastle upon Tyne, UK · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href={SITE}>{host(SITE)}</a> · <a href={GITHUB}>{host(GITHUB)}</a> · <a href={LINKEDIN}>{host(LINKEDIN)}</a>
        </p>
        <p class="call" set:html={inlineMd(call)} />
      </header>
      <div class="body"><Content components={{ Job, Meta }} /></div>
    </main>
  </div>
  <Toggletip />
  <script>
    document.querySelector('[data-print]')?.addEventListener('click', () => print());
  </script>
</Base>

<style>
  /* Light by default here (paper); dark when chosen on the site or by the system. */
  .cv {
    --cv-bg: #f4f4f2;
    --cv-page: #ffffff;
    --cv-ink: #16171a;
    --cv-mute: #55585f;
    --cv-rule: #dcdde0;
    --cv-acc: #8a4b00;
    --cv-call: #f6f1e8;
    --cv-btn: #16171a;
    --cv-btn-h: #000000;
    --cv-btn-t: #ffffff;
    /* The site's own palette, for search and jump and the glossary popups on this page. */
    --panel: var(--cv-page);
    --panel2: var(--cv-call);
    --line2: var(--cv-rule);
    --line3: var(--cv-rule);
    --head: var(--cv-ink);
    --text: var(--cv-ink);
    --text2: var(--cv-ink);
    --mute: var(--cv-mute);
    --dim: var(--cv-mute);
    --acc: var(--cv-acc);
    --acc-bg: var(--cv-call);
    min-height: 100vh;
    background: var(--cv-bg);
    color: var(--cv-ink);
    font-family: 'Inter', Arial, Helvetica, sans-serif;
    font-size: 14.5px;
    line-height: 1.5;
    color-scheme: light;
  }
  :global(:root[data-theme='dark']) .cv {
    --cv-bg: #111214;
    --cv-page: #1a1b1f;
    --cv-ink: #e9e9ec;
    --cv-mute: #a8abb2;
    --cv-rule: #34363c;
    --cv-acc: #e4a95e;
    --cv-call: #2a241a;
    --cv-btn: #e9e9ec;
    --cv-btn-h: #ffffff;
    --cv-btn-t: #111214;
    color-scheme: dark;
  }
  /* The page's own background on <html> as well as <body>: the browser paints anything below the body,
     and the overscroll, with <html>'s, which is otherwise the site's green. */
  :global(html:has(.cv)),
  :global(body:has(.cv)) {
    background: #f4f4f2;
  }
  :global(:root[data-theme='dark']:has(.cv)),
  :global(:root[data-theme='dark'] body:has(.cv)) {
    background: #111214;
  }
  @media print {
    :global(html:has(.cv)),
    :global(body:has(.cv)) {
      background: #fff;
    }
  }
  .cv a {
    color: var(--cv-acc);
    text-underline-offset: 2px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    max-width: 820px;
    margin: 0 auto;
    padding: 24px 16px 0;
    font-size: 14px;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tools [hidden] {
    display: none;
  }
  .btn {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 6px;
    background: var(--cv-btn);
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: var(--cv-btn-t);
  }
  .btn:hover {
    background: var(--cv-btn-h);
  }
  .btn:focus-visible,
  .lang:focus-visible {
    outline: 2px solid var(--cv-acc);
    outline-offset: 2px;
  }
  .btn.alt {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--cv-ink);
    color: var(--cv-ink);
    text-decoration: none;
  }
  .cv a.btn {
    color: var(--cv-acc);
  }
  .btn.alt:hover {
    background: var(--cv-btn);
    color: var(--cv-btn-t);
  }
  .theme {
    justify-content: center;
    width: 44px;
    padding: 0;
  }
  .theme > span {
    display: contents;
  }
  .lang {
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1.5px var(--cv-ink);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--cv-ink);
  }
  .lang option {
    background: #fff;
    color: #1b2a22;
  }
  .page {
    max-width: 820px;
    margin: 32px auto;
    padding: 48px 56px;
    background: var(--cv-page);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }
  :global(:root[data-theme='dark']) .page {
    box-shadow: 0 0 0 1px var(--cv-rule);
  }
  h1 {
    margin: 0;
    font-family: inherit;
    font-size: 30px;
    letter-spacing: -0.01em;
  }
  .role {
    margin: 4px 0 8px;
    font-size: 17px;
    font-weight: 600;
  }
  .contact {
    margin: 0;
    color: var(--cv-mute);
  }
  .call {
    margin: 10px 0 0;
    padding: 8px 12px;
    border-inline-start: 3px solid var(--cv-acc);
    background: var(--cv-call);
  }
  .body :global(h2) {
    margin: 28px 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--cv-rule);
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cv-acc);
  }
  .body :global(p) {
    margin: 0;
  }
  .body :global(ul) {
    margin: 0;
    padding-inline-start: 18px;
  }
  .body :global(li) {
    margin: 0 0 4px;
  }
  @media (max-width: 700px) {
    .page {
      margin: 0;
      padding: 28px 18px;
      box-shadow: none;
    }
  }
  @page {
    size: A4;
    margin: 14mm;
  }
  @media print {
    .cv,
    :global(:root[data-theme='dark']) .cv {
      --cv-bg: #ffffff;
      --cv-page: #ffffff;
      --cv-ink: #16171a;
      --cv-mute: #55585f;
      --cv-rule: #dcdde0;
      --cv-acc: #8a4b00;
      --cv-call: #f6f1e8;
      color-scheme: light;
    }
    .page {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
    .noprint {
      display: none !important;
    }
    .cv a {
      color: var(--cv-ink);
      text-decoration: none;
    }
  }
</style>
