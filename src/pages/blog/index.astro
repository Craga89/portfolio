---
// The blog: every post from the old craigsworks blogs, newest first, by year.
import { url } from '../../lib/url';
import FilePage from '../../layouts/FilePage.astro';
import Cta from '../../components/page/Cta.astro';
import { posts } from '../../lib/posts';
import { author } from '../../lib/seo';
import { SITE } from '../../site';

const all = await posts();
const year = (p: (typeof all)[number]) => p.data.date.getUTCFullYear();
const years = [...new Set(all.map(year))];
const span = `${years.at(-1)}–${years[0]}`;
const description = `${all.length} posts from Craig Thompson's old blog on craigsworks.com, ${span}: JavaScript, qTip2, Knockout, Durandal, webpack and more.`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Craig Thompson · blog',
  description,
  url: `${SITE}/blog/`,
  author,
  blogPost: all.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, datePublished: p.data.date.toISOString(), url: `${SITE}/blog/${p.slug}/` })),
};
const dayMonth = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' });
---

<FilePage title="Blog · Craig Thompson" description={description} path="blog/" image="/blog/og.png" imageAlt={`Blog: ${all.length} posts, ${span}. Craig Thompson`} ld={ld} mono>
  <p class="crumb">$ ls -t <a href={url('/#blog')}>blog/</a></p>
  <h1 class="c-sr">Blog</h1>
  <p class="intro">{all.length} posts from my old blog on craigsworks.com, {span}, kept as they were written. Some of the tools have since moved on.</p>
  {
    years.map((y) => (
      <>
        <h2 class="yr">{y}</h2>
        <ol class="list">
          {all
            .filter((p) => year(p) === y)
            .map((p) => (
              <li>
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{dayMonth(p.data.date)}</time>
                <div>
                  <a href={url(`/blog/${p.slug}/`)} data-vt={`p-${p.slug}`}>
                    {p.data.title}
                  </a>
                  <p>{p.summary}</p>
                </div>
              </li>
            ))}
        </ol>
      </>
    ))
  }
  <Cta home="/#blog" homeText="the portfolio" />
</FilePage>

<style>
  .crumb {
    margin: 0 0 18px;
    font-family: var(--f-mono);
    font-size: clamp(15px, 2vw, 18px);
    color: var(--ok);
  }
  .crumb a {
    color: inherit;
  }
  .intro {
    max-width: 64ch;
    margin: 0 0 8px;
    color: var(--text3);
  }
  .yr {
    margin: 30px 0 8px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ok);
  }
  .list {
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
    border-top: 1px dashed var(--line2);
  }
  li {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 4px 18px;
    padding: 14px 0;
    border-bottom: 1px dashed var(--line2);
  }
  time {
    padding-top: 3px;
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--dim);
  }
  li a {
    font-size: 17px;
    font-weight: 600;
    color: var(--head);
    text-decoration: none;
    view-transition-name: attr(data-vt type(<custom-ident>), none);
    view-transition-class: post-title;
  }
  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--acc);
    text-underline-offset: 3px;
  }
  li p {
    margin: 4px 0 0;
    font-size: 14.5px;
    color: var(--text3);
  }
  @media (max-width: 640px), (horizontal-viewport-segments: 2) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
