---
// Each case study's own page.
import type { GetStaticPaths } from 'astro';
import FilePage from '../../layouts/FilePage.astro';
import CaseStudyCard from '../../components/files/CaseStudyCard.astro';
import Crumb from '../../components/page/Crumb.astro';
import FileFooter from '../../components/page/FileFooter.astro';
import { caseStudies, slugOf } from '../../lib/files';
import { articleLd, describe } from '../../lib/seo';

export const getStaticPaths = (async () => {
  const all = await caseStudies();
  return all.map((entry, current) => ({ params: { slug: slugOf(entry.data.file) }, props: { all, current } }));
}) satisfies GetStaticPaths;

const { all, current } = Astro.props;
const entry = all[current];
const { file, title, id } = entry.data;
const path = `case-studies/${slugOf(file)}/`;
const home = `/?case=${id}#case-studies`;
const description = describe(entry.body, `${title}: case studies from Craig Michael Thompson's portfolio.`);
const files = all.map((e) => ({ file: e.data.file, href: `/case-studies/${slugOf(e.data.file)}/` }));
---

<FilePage
  title={`${title} · ${file} · Craig Michael Thompson`}
  description={description}
  path={path}
  type="article"
  image={`/${path}og.png`}
  imageAlt={`${title}. case-studies/${file}, Craig Michael Thompson`}
  ld={articleLd({ headline: title, name: file, description, path })}
  tips
  mono
>
  <Crumb folder="case-studies/" file={file} home={home} />
  <h1 class="c-sr">{title}</h1>
  <CaseStudyCard entry={entry} level={2} />
  <FileFooter folder="case-studies/" files={files} current={current} source={entry.body ?? ''} home={home} />
</FilePage>
