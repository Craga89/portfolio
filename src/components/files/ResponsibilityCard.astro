---
// A responsibility (src/content/responsibilities/<name>.yaml): what it was, what changed, a
// headline number and a short flow.
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'responsibilities'>;
  /** Its position, for "02 / 12". */
  index: number;
  total: number;
  level?: 2 | 3;
  /** On the file's own page: framed. */
  standalone?: boolean;
  /** In the home page's tour: one tab panel of several, hidden until its tab is picked. */
  panel?: { hidden: boolean };
}
const { entry, index, total, level = 3, standalone, panel } = Astro.props;
const { id, file, group, kicker, title, lede, points, stat, flow } = entry.data;
const H = `h${level}` as const;
const pad = (n: number) => String(n).padStart(2, '0');
---

<article
  class="c-rs c-pop"
  data-standalone={standalone ? '' : undefined}
  id={panel ? `rp-${id}` : undefined}
  role={panel ? 'tabpanel' : undefined}
  aria-label={panel ? file : undefined}
  hidden={panel?.hidden}
>
  <div class="top"><span class="where">{pad(index + 1)} / {pad(total)} · {file}</span><span class="group">{group}</span></div>
  <div class="cols">
    <div>
      <div class="kicker">// {kicker}</div>
      <H class="c-rs-t">{title}</H>
      <p class="lede">{lede}</p>
      <ul class="points">{points.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div>
      <div class="stat">{stat.value}</div>
      <div class="stat-label">{stat.label}</div>
      <div class="flow-label">// {flow.label}</div>
      <div class="flow">{flow.steps.map((s) => <span>{s}</span>)}</div>
    </div>
  </div>
</article>

<style>
  .c-rs {
    padding: 22px clamp(22px, 4vw, 48px) 26px;
  }
  .c-rs[data-standalone] {
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--panel);
  }
  @media (min-width: 821px) {
    .c-rs:not([data-standalone]) {
      min-height: 560px;
    }
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    font-family: var(--f-mono);
    font-size: 12.5px;
  }
  .where {
    color: var(--acc);
  }
  .group {
    color: var(--dim);
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 48px);
  }
  .kicker {
    font-size: 13px;
    color: var(--mute);
  }
  .c-rs-t {
    margin: 8px 0 14px;
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--head);
    text-wrap: balance;
  }
  .lede {
    margin: 0 0 20px;
    max-width: 64ch;
    font-size: 15.5px;
    color: var(--text3);
  }
  .points {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    position: relative;
    padding-inline-start: 22px;
    font-size: 15px;
    color: var(--text2);
  }
  .points li::before {
    content: '✓' / '';
    position: absolute;
    inset-inline-start: 0;
    color: var(--ok);
  }
  .stat {
    margin-top: 8px;
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--acc);
  }
  .stat-label {
    margin-top: 6px;
    font-size: 13px;
    color: var(--mute);
  }
  .flow-label {
    margin-top: 22px;
    font-size: 12px;
    color: var(--dim);
  }
  .flow {
    display: grid;
    gap: 6px;
    margin-top: 12px;
  }
  .flow span {
    border-inline-start: 2px solid var(--line3);
    padding-block: 2px;
    padding-inline: 12px 0;
    font-size: 13px;
    color: var(--text3);
    animation: c-pop 0.4s ease both;
    animation-delay: calc(sibling-index() * 90ms + 60ms);
  }
  .flow span:last-child {
    border-inline-start-color: var(--acc);
    color: var(--head);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media print {
    .c-rs[hidden] {
      display: block;
    }
    .c-rs:not([data-standalone]) {
      margin: 0 0 14pt;
      padding: 10pt 0 0;
      border-top: 1px solid var(--line2);
    }
  }
  @media (forced-colors: active) {
    .points li::before {
      color: CanvasText;
    }
  }
</style>
