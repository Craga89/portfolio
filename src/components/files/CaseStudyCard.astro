---
// A case study: its heading, then the MDX body (the lede paragraphs, then its blocks).
import { render, type CollectionEntry } from 'astro:content';
import { components } from '../mdx';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  /** The heading level: h2 on its own page (under the page's h1), h3 in the home page's tabs. */
  level?: 2 | 3;
}
const { entry, level = 3 } = Astro.props;
const { Content } = await render(entry);
const H = `h${level}` as const;
---

<article class="c-pop case">
  <header>
    <div class="kicker">// {entry.data.kicker}</div>
    <H class="title">{entry.data.title}</H>
  </header>
  <Content components={components} />
</article>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 32px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--panel);
    padding: clamp(22px, 4vw, 40px);
  }
  .kicker {
    font-size: 13px;
    color: var(--acc);
  }
  .title {
    margin: 8px 0 0;
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--head);
  }
  /* The lede: the body's paragraphs, which sit close under the heading and each other. */
  .case > :global(p) {
    margin: 0;
    max-width: 72ch;
    color: var(--text3);
  }
  .case > :global(header + p),
  .case > :global(p + p) {
    margin-top: -22px;
  }
</style>
