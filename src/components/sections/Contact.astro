---
// get-in-touch.md: email first, the other ways to reach me, and the facts recruiters ask first.
import { url } from '../../lib/url';
import Section from '../home/Section.astro';
import Icon from '../Icon.astro';
import { EMAIL, GITHUB, LINKEDIN } from '../../site';
---

<Section id="contact" cmd="cat get-in-touch.md" note="contact" file="get-in-touch.md" gap={12}>
  <div class="contact">
    <div>
      <h3 class="t">Let's talk</h3>
      <p class="p">I'm open to hands-on technical leadership roles. If you're hiring, or want to talk about anything on this site, email me.</p>
      <div class="cta">
        <a class="go" href={`mailto:${EMAIL}`}><Icon name="mail" size={18} />{EMAIL}</a>
        <button type="button" class="copy" data-copy={EMAIL} data-copy-note="Email address copied"><Icon name="copy" size={15} /><span data-copy-label>copy address</span></button>
      </div>
      <ul class="links">
        <li><a href={LINKEDIN}><Icon name="linkedin" size={14} />linkedin</a></li>
        <li><a href={GITHUB}><Icon name="github" />github</a></li>
        <li><a href={url('/cv.pdf')} download="Craig-Michael-Thompson-CV.pdf"><Icon name="download" />cv.pdf</a></li>
        <li><a href={url('/cv/')}><Icon name="file" />plain CV</a></li>
        <li><a href={url('/craig-thompson.vcf')} download="Craig-Michael-Thompson.vcf"><Icon name="contact" />add contact</a></li>
      </ul>
    </div>
    <dl class="facts">
      <div><dt>Looking for</dt><dd>Head of Engineering, hands-on technical leadership, AI-first engineering</dd></div>
      <div><dt>Working</dt><dd>Remote, or flexible hybrid in the North East</dd></div>
      <div>
        <dt>Based in</dt>
        <dd>
          Newcastle upon Tyne, UK<span class="time" data-clock hidden><span aria-hidden="true"> · <span class="time-v"><span data-clock-h></span><span class="colon">:</span><span data-clock-m></span><span class="off" data-clock-off></span></span> now</span><span class="c-sr" data-clock-sr></span></span>
        </dd>
      </div>
      <div><dt>Notice period</dt><dd>Three months</dd></div>
    </dl>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(22px, 4vw, 48px);
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--panel);
  }
  .t {
    margin: 0 0 10px;
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.005em;
    color: var(--head);
  }
  .p {
    max-width: 52ch;
    margin: 0 0 22px;
    color: var(--text2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-bottom: 22px;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 4px;
    background: var(--acc);
    color: var(--bg);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .go:hover {
    color: var(--bg);
    transform: translateY(-2px);
  }
  .copy {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 4px;
    cursor: pointer;
    font-size: 14px;
    color: var(--mute);
  }
  .copy:hover {
    color: var(--head);
  }
  .copy:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 18px 0 0;
    border-top: 1px dashed var(--line3);
    list-style: none;
    font-size: 14px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 32px;
  }
  .facts {
    display: grid;
    align-content: start;
    gap: 16px;
    margin: 0;
  }
  .facts div {
    border-inline-start: 2px solid var(--line3);
    padding-inline-start: 14px;
  }
  dt {
    margin-bottom: 2px;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--dim);
  }
  dd {
    margin: 0;
    font-size: 15px;
    color: var(--head);
  }
  .time {
    display: inline;
    font-size: 14px;
    color: var(--mute);
  }
  .time[hidden] {
    display: none;
  }
  .time-v {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .off {
    margin-inline-start: 5px;
    font-size: 0.92em;
    color: var(--dim);
  }
  .colon {
    animation: colon 1s steps(1, end) infinite;
  }
  @keyframes colon {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media print {
    .copy {
      display: none;
    }
    .contact {
      padding: 0;
      border: 0;
    }
  }
</style>
