---
// recommendations.txt: LinkedIn recommendations, quoted as written (src/data/recommendations.yaml).
// Each card shows one line from its recommendation; the whole text opens below it, and the card
// then takes the full width.
import { getCollection } from 'astro:content';
import { excerpt } from '../../../shared/excerpt.js';
import Section from '../home/Section.astro';
import { LINKEDIN } from '../../site';

const recs = await getCollection('recommendations').then((all) => all.sort((a, b) => a.data.order - b.data.order));
---

<Section id="recommendations" cmd="cat recommendations.txt" note="recommendations" file="recommendations.txt" gap={8}>
  <p class="intro">From LinkedIn, quoted as written. <a href={`${LINKEDIN}details/recommendations/`}>See them on LinkedIn →</a></p>
  <div class="grid">
    {
      recs.map(({ data: r }) => (
        <figure class="c-card">
          <p class="hl">
            <span class="q" aria-hidden="true">
              “
            </span>
            {excerpt(r.quote, r.highlight)}
          </p>
          <figcaption>
            <div class="name">{r.name}</div>
            <div class="role">{r.role}</div>
            <div class="when">{r.when}</div>
          </figcaption>
          <details>
            <summary>
              Read the full recommendation<span class="c-sr"> from {r.name}</span>
            </summary>
            <blockquote>
              {r.quote.split(/\n\s*\n/).map((text) => (
                <p>{text}</p>
              ))}
            </blockquote>
          </details>
        </figure>
      ))
    }
  </div>
</Section>

<style>
  .intro {
    max-width: 72ch;
    margin: 0 0 24px;
    font-size: 14px;
    color: var(--mute);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 18px;
  }
  .c-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 24px;
    border: 1px solid var(--line2);
    border-radius: 12px;
    background: var(--panel);
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }
  .c-card:hover {
    border-color: var(--acc);
    transform: translateY(-4px);
  }
  /* Opened: the whole row, so the full text has room for two columns. */
  .c-card:has(details[open]) {
    grid-column: 1 / -1;
    border-color: var(--acc);
    transform: none;
  }
  .hl {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--head);
    text-wrap: pretty;
  }
  .q {
    margin-inline-end: 4px;
    font-size: 30px;
    line-height: 0;
    vertical-align: -10px;
    color: var(--acc);
  }
  figcaption {
    margin-top: auto;
  }
  .name {
    font-weight: 700;
    color: var(--head);
  }
  .role {
    font-size: 13px;
    color: var(--mute);
  }
  .when {
    margin-top: 2px;
    font-size: 12px;
    color: var(--dim);
  }
  details {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    padding-top: 10px;
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--acc);
  }
  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+' / '';
    font-family: var(--f-mono);
    font-size: 18px;
    transition: transform 0.25s ease;
  }
  summary:hover {
    color: var(--acc-h);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  blockquote {
    margin: 12px 0 0;
    columns: 2 340px;
    column-gap: 40px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text2);
  }
  blockquote p {
    margin: 0 0 12px;
    break-inside: avoid;
  }
  /* On paper, the whole text of each, without the highlight or the control. */
  @media print {
    .c-card {
      grid-column: 1 / -1;
      break-inside: avoid;
    }
    .hl,
    summary {
      display: none;
    }
    details::details-content {
      content-visibility: visible;
      display: contents;
    }
  }
  @media (forced-colors: active) {
    .c-card {
      border: 1px solid CanvasText;
    }
  }
</style>
