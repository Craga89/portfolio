---
// The introduction, as a terminal window: whoami (the name and portrait), the role, the tagline and
// introduction (src/content/sections/intro.mdx), and a prompt to get in touch. In its corner, the
// Tyne Bridge; the Konami code lights it up (scripts/bridge.ts).
import { url } from '../../lib/url';
import { Picture } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import portrait from '../../assets/portrait.webp';
import portraitNight from '../../assets/portrait-night.webp';
import ContactLinks from '../home/ContactLinks.astro';
import Focus from '../home/Focus.astro';
import Icon from '../Icon.astro';
import { components } from '../mdx';
import { EMAIL, NAME, PORTRAIT_ALT, PORTRAIT_ALT_NIGHT, ROLE } from '../../site';

const intro = await getEntry('sections', 'intro');
if (!intro) throw new Error('src/content/sections/intro.mdx is missing');
const { Content } = await render(intro);

// The Tyne Bridge, in a 1000×190 box: the arch (two ribs), the deck running through it, hangers
// from the arch to the deck, the towers at each end and the river below.
const HANGERS = 'M241 124 V117 M315 124 V92 M389 124 V75 M463 124 V66 M537 124 V66 M611 124 V75 M685 124 V92 M759 124 V117';
// Fireworks over the bridge when it's lit: six bursts of twelve sparks.
const BURSTS = [0, 1, 2, 3, 4, 5];
const SPARKS = Array.from({ length: 12 }, (_, i) => i);
const RIVER = 'M0 182 Q40 176 80 182 T160 182 T240 182 T320 182 T400 182 T480 182 T560 182 T640 182 T720 182 T800 182 T880 182 T960 182 T1040 182';
---

<section aria-label="Introduction" class="intro">
  <div class="term">
    <svg class="bridge" viewBox="0 0 1000 190" aria-hidden="true" focusable="false">
      <path class="arch" d="M130 172 Q500 -42 870 172" pathLength="1"></path>
      <path class="arch rib" d="M150 172 Q500 -12 850 172" pathLength="1"></path>
      <path class="hangers" d={HANGERS} pathLength="1"></path>
      <path class="deck" d="M0 124 H1000" pathLength="1"></path>
      <path class="towers" d="M70 124 V56 H118 V124 M882 124 V56 H930 V124 M70 76 H118 M882 76 H930" pathLength="1"></path>
      <path class="river" d={RIVER}></path>
    </svg>
    <div class="fw" aria-hidden="true">{BURSTS.map(() => <span class="burst">{SPARKS.map(() => <i></i>)}</span>)}</div>
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span translate="no">craig@newcastle: ~</span></div>
    <div class="body">
      <div class="top">
        <div class="who">
          <p class="pr" translate="no">$ whoami</p>
          <h1>{NAME}</h1>
          <p class="role">{ROLE.split(' · ').map((part, i, all) => <>{i > 0 && ' '}<span>{part}{i < all.length - 1 && ' ·'}</span></>)}</p>
        </div>
        <figure class="ph">
          {/* Daytime in the light theme, lamplight in the dark one. Only the one showing is fetched (the other is display: none and lazy). The whole <picture> is hidden, not just its image, so the hidden one doesn't take up a gap in the column. */}
          <Picture pictureAttributes={{ class: 'when-light' }} src={portrait} alt={PORTRAIT_ALT} formats={['avif', 'webp']} widths={[96, 192, 352]} sizes="(max-width: 600px) 120px, 200px" loading="lazy" />
          <Picture pictureAttributes={{ class: 'when-dark' }} src={portraitNight} alt={PORTRAIT_ALT_NIGHT} formats={['avif', 'webp']} widths={[96, 192, 352]} sizes="(max-width: 600px) 120px, 200px" loading="lazy" />
          <figcaption aria-hidden="true" translate="no">portrait.webp</figcaption>
        </figure>
      </div>
      <p class="print-only"><a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href="https://craigthompson.dev/">craigthompson.dev</a> · github.com/Craga89 · linkedin.com/in/craigmichaelthompson · Newcastle upon Tyne, UK<br />The short CV is at craigthompson.dev/cv.</p>
      <div id="about" class="about"><Content components={components} /></div>
      <Focus />
      <p class="cta"><a class="c-btn" href="#contact">./get-in-touch</a><a class="cv" href={url('/cv.pdf')} translate="no">cat cv.pdf</a><span class="cursor" aria-hidden="true"></span></p>
    </div>
  </div>
  <div class="mcta">
    <ContactLinks />
    <button type="button" class="motion" data-motion-toggle><span class="when-moving"><Icon name="pause" size={14} />pause animations</span><span class="when-still"><Icon name="play" size={14} />play animations</span></button>
  </div>
</section>

<style>
  .intro {
    padding-top: 8px;
    padding-bottom: 64px;
  }
  /* The bridge: faint, in the bottom corner of the window behind the prompt, cut off by its edge. */
  .bridge {
    --b: var(--line3);
    position: absolute;
    right: -60px;
    bottom: -14px;
    z-index: -1;
    width: min(620px, 80%);
    height: auto;
    overflow: visible;
    pointer-events: none;
    opacity: 0.5;
    transition: opacity 0.6s ease;
  }
  :root[data-theme='light'] .bridge {
    --b: var(--line2);
  }
  .bridge path {
    fill: none;
    stroke: var(--b);
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.6s ease;
  }
  .arch,
  .deck {
    stroke-width: 5;
  }
  .rib {
    stroke-width: 2.5;
  }
  .hangers {
    stroke-width: 2;
  }
  .towers {
    stroke-width: 4;
  }
  .river {
    stroke-width: 2;
    opacity: 0.6;
  }
  /* Lit up, it's the real bridge's colours: the green steel arch and deck, the granite towers and
     the river, drawn in as it lights, with fireworks over it. */
  .bridge {
    --steel: #237a4c;
    --granite: #8c8576;
    --water: #3d7fb5;
  }
  :root:not([data-theme='light']) .bridge {
    --steel: #4cbb7f;
    --granite: #c9c2b2;
    --water: #5aa9e6;
  }
  :root[data-bridge] .bridge {
    opacity: 1;
  }
  :root[data-bridge] .bridge path:not(.river) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  :root[data-bridge] :is(.arch, .rib, .hangers, .deck) {
    stroke: var(--steel);
  }
  :root[data-bridge] .arch {
    filter: drop-shadow(0 0 6px var(--steel));
  }
  :root[data-bridge] .towers {
    stroke: var(--granite);
    animation-delay: 0.4s;
  }
  :root[data-bridge] .river {
    stroke: var(--water);
    opacity: 1;
  }
  :root[data-bridge] .rib {
    animation-delay: 0.2s;
  }
  :root[data-bridge] .hangers {
    animation-delay: 0.7s;
  }
  /* Fireworks: each burst is twelve sparks flying out from one point and falling as they fade.
     Only while the bridge is lit, and only with motion on. */
  .fw {
    display: none;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .burst {
    --c: #ffd166;
    --r: 110px;
    position: absolute;
    right: 24%;
    bottom: 40%;
    width: 0;
    height: 0;
  }
  .burst:nth-child(2) {
    --c: #ef476f;
    --r: 90px;
    right: 46%;
    bottom: 55%;
  }
  .burst:nth-child(3) {
    --c: #06d6a0;
    --r: 120px;
    right: 9%;
    bottom: 62%;
  }
  .burst:nth-child(4) {
    --c: #f4f1de;
    --r: 80px;
    right: 34%;
    bottom: 72%;
  }
  .burst:nth-child(5) {
    --c: #8ecae6;
    --r: 100px;
    right: 60%;
    bottom: 38%;
  }
  .burst:nth-child(6) {
    --c: #ffb4a2;
    --r: 95px;
    right: 15%;
    bottom: 30%;
  }
  :root[data-theme='light'] .burst:nth-child(4) {
    --c: #7b5cd6;
  }
  :root[data-theme='light'] .burst:nth-child(5) {
    --c: #1d6fa5;
  }
  .burst i {
    --a: 0deg;
    position: absolute;
    width: 6px;
    height: 6px;
    margin: -3px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 6px 1px var(--c);
    opacity: 0;
  }
  .burst i:nth-child(2) {
    --a: 30deg;
  }
  .burst i:nth-child(3) {
    --a: 60deg;
  }
  .burst i:nth-child(4) {
    --a: 90deg;
  }
  .burst i:nth-child(5) {
    --a: 120deg;
  }
  .burst i:nth-child(6) {
    --a: 150deg;
  }
  .burst i:nth-child(7) {
    --a: 180deg;
  }
  .burst i:nth-child(8) {
    --a: 210deg;
  }
  .burst i:nth-child(9) {
    --a: 240deg;
  }
  .burst i:nth-child(10) {
    --a: 270deg;
  }
  .burst i:nth-child(11) {
    --a: 300deg;
  }
  .burst i:nth-child(12) {
    --a: 330deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    :root[data-bridge]:not([data-motion='off']) .fw {
      display: block;
    }
    :root[data-bridge] .burst i {
      animation: spark 1.8s cubic-bezier(0.2, 0.7, 0.3, 1) infinite;
      animation-delay: 1.4s;
    }
    :root[data-bridge] .burst:nth-child(2) i {
      animation-delay: 1.85s;
    }
    :root[data-bridge] .burst:nth-child(3) i {
      animation-delay: 2.3s;
    }
    :root[data-bridge] .burst:nth-child(4) i {
      animation-delay: 2.75s;
    }
    :root[data-bridge] .burst:nth-child(5) i {
      animation-delay: 2.05s;
    }
    :root[data-bridge] .burst:nth-child(6) i {
      animation-delay: 1.6s;
    }
  }
  @keyframes spark {
    0% {
      opacity: 1;
      transform: rotate(var(--a)) translateX(0) scale(1.4);
    }
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(28px) rotate(var(--a)) translateX(var(--r)) scale(0.4);
    }
  }
  /* Without motion, it's simply lit. */
  :root[data-bridge][data-motion='off'] .bridge path {
    animation: none;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :root[data-bridge] .bridge path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* The window: a panel with a title bar, with the bridge drawn inside it behind the text. */
  .term {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--line3);
    border-radius: 14px;
    background: var(--panel);
    box-shadow: 0 30px 60px -32px rgb(0 0 0 / 0.45);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line2);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--mute);
  }
  .bar i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .bar i:nth-child(2) {
    background: #febc2e;
  }
  .bar i:nth-child(3) {
    background: #28c840;
  }
  .bar span {
    margin-inline-start: 10px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 3.2vw, 36px) clamp(20px, 3.6vw, 40px) clamp(24px, 3.6vw, 40px);
    /* The name and portrait size themselves to the window's width (cqi), so they sit side by side
       on every screen. */
    container-type: inline-size;
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 4cqi, 40px);
    margin-bottom: 6px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  /* A shell prompt line. */
  .pr {
    margin: 0;
    font-family: var(--f-mono);
    font-size: clamp(15px, 1.5vw, 17px);
    color: var(--ok);
  }
  h1 {
    margin: 0 0 4px;
    /* Sized so "Thompson", the longest line, fits beside the portrait: the column is what's left
       after the portrait (24cqi) and the gap. */
    font-size: clamp(34px, 15.5cqi, 96px);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: 0.005em;
    color: var(--head);
    text-wrap: balance;
  }
  /* Each part of the role ("Head of Engineering", "hands-on, AI-first") stays on one line. */
  .role span {
    white-space: nowrap;
  }
  .role {
    margin: 0 0 4px;
    font-size: clamp(18px, 1.9vw, 22px);
    color: var(--acc);
  }
  .ph {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: clamp(72px, 24cqi, 200px);
    margin: 0;
  }
  .ph :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--line3);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ph:hover :global(img) {
    transform: scale(1.03);
  }
  figcaption {
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--mute);
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    color: var(--text2);
  }
  .about :global(p) {
    margin: 0;
  }
  .about :global(.tagline) {
    max-width: none;
    color: var(--head);
  }
  .about :global(.tagline a) {
    color: var(--acc);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 10px 0 0;
  }
  .cv {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line3);
    border-radius: 8px;
    /* Solid, so the bridge behind it doesn't show through. */
    background: var(--panel);
    font-family: var(--f-mono);
    font-size: 15px;
    color: var(--head);
    text-decoration: none;
  }
  .cv:hover {
    border-color: var(--acc);
    color: var(--head);
  }
  .cursor {
    width: 10px;
    height: 22px;
    background: var(--acc);
  }
  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-motion='off']) .cursor {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .print-only {
    display: none;
  }
  .mcta {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    margin-top: 24px;
    font-size: 14px;
  }
  .c-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 8px;
    background: var(--acc);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .c-btn:hover {
    color: var(--bg);
    transform: translateY(-2px);
  }
  .motion {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    cursor: pointer;
    font-size: 12px;
    color: var(--mute);
  }
  .motion > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .motion:hover {
    color: var(--head);
    text-decoration: underline;
  }
  .motion:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }
  @media (max-width: 600px), (max-width: 900px) and (max-height: 599px) {
    .mcta {
      display: flex;
    }
  }
  @media (max-width: 600px) {
    .term {
      border-radius: 12px;
    }
    .top {
      align-items: start;
    }
    figcaption,
    .cursor {
      display: none;
    }
  }
  @media print {
    .intro {
      padding: 0;
    }
    .bridge,
    .mcta {
      display: none;
    }
    .print-only {
      display: block;
      margin: 0 0 14pt;
      font-size: 9.5pt;
      color: var(--mute);
    }
    .print-only a {
      color: inherit;
      text-decoration: none;
    }
    .term {
      border: 0;
      background: none;
      box-shadow: none;
    }
    .bar,
    .pr,
    .cta,
    figcaption {
      display: none;
    }
    .body {
      padding: 0;
    }
    h1 {
      margin: 0;
      font-size: 34pt;
      line-height: 0.9;
    }
    .ph {
      width: 64pt;
    }
  }
</style>
