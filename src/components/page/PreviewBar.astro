---
// On branch previews only: a bar across the top saying this is a preview of a branch, not the live
// site, with links to the other previews and to the live site.
import { BASE, PREVIEW, PREVIEW_BRANCH } from '../../lib/url';

// The previews live at /preview/<branch>/: the list of them is one level up, and the live site two.
const previews = BASE.replace(/[^/]+\/$/, '');
const live = previews.replace(/[^/]+\/$/, '');
---

{
  PREVIEW && (
    <aside class="preview-bar" aria-label="Branch preview">
      <p>
        <strong>Branch preview</strong> of <code>{PREVIEW_BRANCH || BASE}</code>, built before the checks run.
        <a href={previews}>All previews</a> · <a href={live}>Live site</a>
      </p>
      <p class="fold" data-fold hidden />
    </aside>
  )
}

<script>
  // What the browser reports about a foldable's screen, for trying the fold layouts on a device:
  // the posture (Device Posture API) and the screen's segments (Viewport Segments API).
  import { PREVIEW } from '../../lib/url';

  type Fold = Window & { viewport?: { segments?: DOMRect[] | null } };
  type Posture = Navigator & { devicePosture?: EventTarget & { type: string } };
  const out = document.querySelector<HTMLElement>('[data-fold]');
  const posture = (navigator as Posture).devicePosture;
  if (PREVIEW && out) {
    const show = () => {
      const segs = (window as Fold).viewport?.segments;
      const parts = [
        `viewport ${innerWidth}×${innerHeight}`,
        posture ? `posture ${posture.type}` : 'no Device Posture API',
        segs
          ? `${segs.length} segment${segs.length === 1 ? '' : 's'}: ${segs.map((r) => `${Math.round(r.width)}×${Math.round(r.height)} at ${Math.round(r.x)},${Math.round(r.y)}`).join(', ')}`
          : 'no Viewport Segments API',
      ];
      out.textContent = `Foldable: ${parts.join(' · ')}`;
      out.hidden = false;
    };
    show();
    addEventListener('resize', show);
    posture?.addEventListener('change', show);
  }
</script>

<style>
  .preview-bar {
    background: var(--acc-bg);
    border-bottom: 1px solid var(--line2);
    color: var(--text);
    font-size: 0.875rem;
  }
  p {
    margin: 0;
    padding: 8px 24px;
  }
  .fold {
    padding-top: 0;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--mute);
  }
  .fold[hidden] {
    display: none;
  }
  strong {
    color: var(--head);
  }
  code {
    font-family: var(--f-mono);
    color: var(--acc);
    /* A long branch name wraps rather than widening the page. */
    overflow-wrap: anywhere;
  }
  /* Kept out of the printed CV (cv.pdf is printed from the page). */
  @media print {
    .preview-bar {
      display: none;
    }
  }
  a {
    color: var(--head);
  }
</style>
