---
// Under a file on its own page: the terms it uses, the previous and next files, every file in the
// folder, and the call to action.
import { url } from '../../lib/url';
import { getEntry } from 'astro:content';
import Cta from './Cta.astro';

interface Item {
  file: string;
  href: string;
}
interface Props {
  /** The folder, as shown: case-studies/ or responsibilities/. */
  folder: string;
  files: Item[];
  current: number;
  /** The MDX source, to find the glossary terms it uses (none for a responsibility). */
  source?: string;
  home: string;
}
const { folder, files, current, source = '', home } = Astro.props;
const prev = files[(current - 1 + files.length) % files.length];
const next = files[(current + 1) % files.length];
const ids = [...new Set([...source.matchAll(/<Term id="([\w-]+)"/g)].map((m) => m[1]))];
const terms = (await Promise.all(ids.map((id) => getEntry('glossary', id)))).filter((t) => t !== undefined);
---

{
  terms.length > 0 && (
    <section class="terms" aria-labelledby="sp-terms-h">
      <h2 id="sp-terms-h"># terms used</h2>
      <dl>
        {terms.map((t) => (
          <>
            <dt>{t.data.title}</dt>
            <dd>{t.data.text}</dd>
          </>
        ))}
      </dl>
    </section>
  )
}
<nav class="pn" aria-label={`More ${folder}`}>
  <a href={url(prev.href)}><span>← previous</span><b>{prev.file}</b></a>
  <a class="next" href={url(next.href)}><span>next →</span><b>{next.file}</b></a>
</nav>
<section class="more" aria-labelledby="sp-more-h">
  <h2 id="sp-more-h">$ ls {folder}</h2>
  <ul>{files.map((f, i) => <li><a href={url(f.href)} aria-current={i === current ? 'page' : undefined}>{f.file}</a></li>)}</ul>
</section>
<Cta home={home} />

<style>
  .terms {
    margin-top: 28px;
    border-top: 1px dashed var(--line3);
    padding-top: 16px;
  }
  h2 {
    margin: 0 0 10px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ok);
  }
  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  dt {
    color: var(--head);
    font-weight: 700;
  }
  dd {
    margin: 0 0 6px;
    font-size: 14.5px;
    color: var(--text3);
  }
  .pn {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
  }
  .pn a {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    max-width: 48%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line3);
    border-radius: 8px;
    text-decoration: none;
  }
  .pn span {
    font-size: 12px;
    color: var(--dim);
  }
  .pn b {
    font-family: var(--f-mono);
    font-weight: 500;
    color: var(--acc);
  }
  .pn .next {
    margin-inline-start: auto;
    text-align: end;
  }
  .more {
    margin-top: 36px;
  }
  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line3);
    border-radius: 6px;
    font-family: var(--f-mono);
    font-size: 13px;
    text-decoration: none;
    color: var(--text3);
  }
  .more a[aria-current='page'] {
    border-color: var(--acc);
    background: var(--acc-bg);
    color: var(--head);
  }
  @media print {
    .pn,
    .more {
      display: none;
    }
  }
</style>
