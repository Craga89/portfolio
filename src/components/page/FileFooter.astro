---
// Under a file on its own page: the glossary terms it uses. The links to the other files are in
// FileNav, after the page.
import { getEntry } from 'astro:content';

interface Props {
  /** The MDX source, to find the glossary terms it uses (none for a responsibility). */
  source?: string;
}
const { source = '' } = Astro.props;
const ids = [...new Set([...source.matchAll(/<Term id="([\w-]+)"/g)].map((m) => m[1]))];
const terms = (await Promise.all(ids.map((id) => getEntry('glossary', id)))).filter((t) => t !== undefined);
---


{
  terms.length > 0 && (
    <section class="terms" aria-labelledby="sp-terms-h">
      <h2 id="sp-terms-h"># terms used</h2>
      <dl>
        {terms.map((t) => (
          <>
            <dt>{t.data.title}</dt>
            <dd>{t.data.text}</dd>
          </>
        ))}
      </dl>
    </section>
  )
}

<style>

  .terms {
    margin-top: 28px;
    border-top: 1px dashed var(--line3);
    padding-top: 16px;
  }
  h2 {
    margin: 0 0 10px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ok);
  }
  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }
  dt {
    color: var(--head);
    font-weight: 700;
  }
  dd {
    margin: 0 0 6px;
    font-size: 14.5px;
    color: var(--text3);
  }
</style>
