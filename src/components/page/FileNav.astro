---
// After a file on its own page: the previous and next files, every file in the folder, and the call
// to action. FilePage puts it after the page, or beside it on a foldable in book posture.
import { url } from '../../lib/url';
import Cta from './Cta.astro';

interface Item {
  file: string;
  href: string;
}
interface Props {
  /** The folder, as shown: case-studies/ or responsibilities/. */
  folder: string;
  files: Item[];
  current: number;
  home: string;
}
const { folder, files, current, home } = Astro.props;
const prev = files[(current - 1 + files.length) % files.length];
const next = files[(current + 1) % files.length];
---

<nav class="pn" aria-label={`More ${folder}`}>
  <a href={url(prev.href)}><span>← previous</span><b>{prev.file}</b></a>
  <a class="next" href={url(next.href)}><span>next →</span><b>{next.file}</b></a>
</nav>
<section class="more" aria-labelledby="sp-more-h">
  <h2 id="sp-more-h">$ ls {folder}</h2>
  <ul>{files.map((f, i) => <li><a href={url(f.href)} aria-current={i === current ? 'page' : undefined}>{f.file}</a></li>)}</ul>
</section>
<Cta home={home} />

<style>
  h2 {
    margin: 0 0 10px;
    font-family: var(--f-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--ok);
  }
  .pn {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
  }
  .pn a {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    max-width: 48%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line3);
    border-radius: 8px;
    text-decoration: none;
  }
  .pn span {
    font-size: 12px;
    color: var(--dim);
  }
  .pn b {
    font-family: var(--f-mono);
    font-weight: 500;
    color: var(--acc);
  }
  .pn .next {
    margin-inline-start: auto;
    text-align: end;
  }
  .more {
    margin-top: 36px;
  }
  .more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line3);
    border-radius: 6px;
    font-family: var(--f-mono);
    font-size: 13px;
    text-decoration: none;
    color: var(--text3);
  }
  .more a[aria-current='page'] {
    border-color: var(--acc);
    background: var(--acc-bg);
    color: var(--head);
  }
  @media print {
    .pn,
    .more {
      display: none;
    }
  }
</style>
