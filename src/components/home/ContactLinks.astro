---
// Email (with a copy button), GitHub, LinkedIn and the CV in its three forms: in the sidebar and
// the mobile menu.
import Icon from '../Icon.astro';
import { EMAIL, GITHUB, LINKEDIN } from '../../site';

interface Props {
  class?: string;
  label?: string;
}
const { class: cls, label } = Astro.props;
---

<div class:list={['links', cls]} role={label ? 'group' : undefined} aria-label={label}>
  <a class="soc" href={`mailto:${EMAIL}`} title={EMAIL}><Icon name="mail" />email</a><button type="button" class="copy" aria-label="Copy email address" title="Copy email address" data-copy={EMAIL} data-copy-note="Email address copied"><Icon name="copy" size={14} class="idle" /><Icon name="check" size={14} class="done" /></button>
  <a class="soc" href={GITHUB}><Icon name="github" />github</a>
  <a class="soc" href={LINKEDIN}><Icon name="linkedin" size={14} />linkedin</a>
  <a class="soc" href="/cv/"><Icon name="file" />plain CV</a>
  <a class="soc" href="/cv.pdf" download="Craig-Michael-Thompson-CV.pdf"><Icon name="download" />cv.pdf</a>
  <a class="soc" href="/craig-thompson.vcf" download="Craig-Michael-Thompson.vcf"><Icon name="contact" />add contact</a>
  <button type="button" class="share" data-share hidden><Icon name="share" />share</button>
</div>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .soc {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .soc :global(.ico) {
    box-sizing: content-box;
    padding: 5px;
    border-radius: 5px;
    background: var(--panel2);
    box-shadow:
      inset 0 0 0 1px var(--line3),
      inset 0 -2px 0 var(--line2);
  }
  .copy {
    all: unset;
    box-sizing: border-box;
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-inline-start: -6px;
    border-radius: 5px;
    cursor: pointer;
    color: var(--mute);
  }
  .copy:hover {
    background: var(--panel2);
    color: var(--head);
  }
  .copy :global(.done),
  .copy[data-done] :global(.idle) {
    display: none;
  }
  .copy[data-done] :global(.done) {
    display: block;
  }
  .share {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
    cursor: pointer;
    font-size: 14px;
    color: var(--acc);
  }
  .share[hidden] {
    display: none;
  }
  .share:hover {
    text-decoration: underline;
  }
  .share:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
    border-radius: 5px;
  }
  .copy:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 1px;
  }
  /* In the mobile menu: a grid of full-size buttons. */
  .links.grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .grid .soc {
    box-sizing: border-box;
    justify-content: center;
    min-height: 44px;
    padding: 0 10px;
    border: 1px solid var(--line3);
    border-radius: 8px;
    font-size: 14px;
    color: var(--text2);
    text-decoration: none;
  }
  .grid .soc:hover {
    border-color: var(--acc);
    color: var(--head);
  }
  .grid .soc :global(.ico) {
    padding: 0;
    background: none;
    box-shadow: none;
  }
  .grid .copy {
    display: none;
  }
  @media print {
    .copy,
    .share {
      display: none;
    }
  }
</style>
