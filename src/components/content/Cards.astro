---
// A grid of short notes, each a <Card>, optionally under a caption.
import Block from './Block.astro';

interface Props {
  label?: string;
}
---

<Block label={Astro.props.label}><div class="cards"><slot /></div></Block>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 12px;
  }
</style>
