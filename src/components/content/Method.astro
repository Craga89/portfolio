---
// How the work was done, as numbered steps that light up in turn. Each child is a <Step>.
---

<ol aria-label="Method" class="method"><slot /></ol>

<style>
  .method {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    counter-reset: method;
  }
  /* <Step> renders a chip; here each one is numbered and lights up in turn. */
  .method :global(.chip) {
    counter-increment: method;
    border: 1px solid var(--ok);
    border-radius: 6px;
    padding: 8px 14px;
    color: var(--text);
    background: none;
    animation: c-lit 0.5s ease both;
    animation-delay: 0.1s;
  }
  .method :global(.chip)::before {
    content: counter(method) ' · ';
  }
  .method :global(.step:nth-child(2) .chip) { animation-delay: 0.35s; }
  .method :global(.step:nth-child(3) .chip) { animation-delay: 0.6s; }
  .method :global(.step:nth-child(4) .chip) { animation-delay: 0.85s; }
  .method :global(.step:nth-child(n + 5) .chip) { animation-delay: 1.1s; }
</style>
