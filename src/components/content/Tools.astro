---
// A list of named tools (functions, commands), each a <Tool>.
import Block from './Block.astro';

interface Props {
  label: string;
}
---

<Block label={Astro.props.label}><ul class="tools"><slot /></ul></Block>

<style>
  .tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 8px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
