---
// Steps in order, joined by arrows: how something flows from one stage to the next. `loop` adds a
// ↻ after the last step, for a cycle.
import Block from './Block.astro';

interface Props {
  label?: string;
  loop?: boolean;
  /** The old way of doing it: muted steps and arrows. */
  faded?: boolean;
  /** Highlight the caption. */
  tone?: 'acc';
}
const { label, loop, faded, tone } = Astro.props;
---

<Block label={label} tone={tone}>
  <ol class="chain" aria-label={label} data-loop={loop ? '' : undefined} data-faded={faded ? '' : undefined}><slot /></ol>
</Block>

<style>
  .chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .chain {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chain[data-faded] :global(.chip) {
    color: var(--text3);
  }
  .chain[data-faded] :global(.step + .step)::before {
    color: var(--dim);
  }
  /* A cycle: back to the start. */
  .chain[data-loop]::after {
    content: '↻' / '';
    color: var(--acc);
  }
</style>
