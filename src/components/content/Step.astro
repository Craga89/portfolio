---
// One step in a <Chain> or <Method>, with an arrow from the step before. `tone` marks it: acc for the key steps, ok for where it ends.
interface Props {
  tone?: 'acc' | 'ok';
}
const { tone } = Astro.props;
---

<li class="step"><span class="c-pop chip" data-tone={tone}><slot /></span></li>

<style>
  .step {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .step + .step::before {
    content: '→' / '';
    color: var(--acc);
  }
  .chip {
    border: 1px solid var(--line3);
    border-radius: 6px;
    padding: 8px 12px;
  }
  .chip[data-tone='acc'] {
    border-color: var(--acc);
    background: var(--acc-bg);
    color: var(--head);
  }
  .chip[data-tone='ok'] {
    border-color: var(--ok);
    color: var(--head);
  }
  .step:nth-child(2) .chip { animation-delay: 0.15s; }
  .step:nth-child(3) .chip { animation-delay: 0.3s; }
  .step:nth-child(4) .chip { animation-delay: 0.45s; }
  .step:nth-child(5) .chip { animation-delay: 0.6s; }
  .step:nth-child(n + 6) .chip { animation-delay: 0.75s; }
</style>
