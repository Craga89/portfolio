---
interface Props {
  /** A short aside after the name, red in the old architecture, green in the new. */
  note?: string;
  /** acc for the public entry point, ok for the private layers behind it. */
  tone?: 'acc' | 'ok';
}
const { note, tone } = Astro.props;
---

<li class="layer"><div class="box" data-tone={tone}><slot />{note && <span class="note"> · {note}</span>}</div></li>

<style>
  .layer {
    --i: calc(sibling-index() - 1);
  }
  .box {
    border: 1px solid var(--line3);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--text3);
  }
  .box[data-tone='acc'] {
    border-color: var(--acc);
    background: var(--acc-bg);
  }
  .box[data-tone='ok'] {
    border-color: var(--ok);
  }
  .note {
    font-size: 12px;
    color: var(--ok);
  }
</style>
