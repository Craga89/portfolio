---
// Rate-limit buckets filling up, one per identity. `fill` is a percentage; drawn as SVG so the
// heights need no inline styles.
interface Props {
  items: { label: string; fill: number }[];
}
---

<ul class="buckets" aria-hidden="true">
  {
    Astro.props.items.map(({ label, fill }) => (
      <li>
        <svg viewBox="0 0 34 64" width="34" height="64">
          <rect class="level" x="0" y={64 - (64 * fill) / 100} width="34" height={(64 * fill) / 100} />
        </svg>
        <span>{label}</span>
      </li>
    ))
  }
</ul>

<style>
  .buckets {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    --i: calc(sibling-index() - 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  svg {
    display: block;
    border: 1px solid var(--line3);
    border-radius: 6px;
    overflow: hidden;
  }
  .level {
    fill: var(--acc);
    opacity: 0.85;
    transform-box: fill-box;
    transform-origin: bottom;
    animation: c-grow 0.9s cubic-bezier(0.3, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 0.15s);
  }
  span {
    font-size: 12px;
    color: var(--text3);
  }
  @keyframes c-grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
