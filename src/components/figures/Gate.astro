---
interface Props {
  name: string;
}
---

<li class="gate"><span class="k">{Astro.props.name}</span><span><slot /></span></li>

<style>
  .gate {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    font-size: 14.5px;
    color: var(--text2);
  }
  .k {
    border: 1px solid var(--ok);
    border-radius: 4px;
    padding: 1px 6px;
    text-align: center;
    font-family: var(--f-mono);
    font-size: 12.5px;
    color: var(--ok);
  }
</style>
