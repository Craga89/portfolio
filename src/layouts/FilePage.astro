---
// The pages other than the home page: a file, a blog post, the blog index, the 404. A slim header
// (home, search, theme, motion), then the page.
import { url } from '../lib/url';
import Base from './Base.astro';
import Toggletip from '../components/page/Toggletip.astro';

type BaseProps = Parameters<typeof Base>[0];
type Props = BaseProps & {
  /** Include the glossary popover (pages whose text has <Term>s). */
  tips?: boolean;
};
const { tips, ...base } = Astro.props;
---

<Base {...base}>
  <slot name="head" slot="head" />
  <div class="sp">
    <header class="top">
      <a class="home" href={url('/')}><span class="c-dot" aria-hidden="true"></span>craigthompson.dev</a>
      <div class="tools">
        <button type="button" class="b" data-palette aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K" title="Search and jump (Ctrl+K)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>search
        </button>
        <button type="button" class="b" data-theme-toggle><span class="when-dark">light theme</span><span class="when-light">dark theme</span></button>
        <button type="button" class="b" data-motion-toggle><span class="when-moving">pause animations</span><span class="when-still">play animations</span></button>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
    {
      Astro.slots.has('end') && (
        <div class="end">
          <slot name="end" />
        </div>
      )
    }
  </div>
  {tips && <Toggletip />}
</Base>

<style>
  .sp {
    max-width: 980px;
    margin: 0 auto;
    padding: clamp(18px, 4vw, 40px) clamp(16px, 4vw, 40px) 72px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    margin-bottom: clamp(20px, 4vw, 36px);
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--f-mono);
    font-weight: 700;
    color: var(--head);
    text-decoration: none;
  }
  .home:hover {
    color: var(--head);
  }
  .c-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ok);
    animation: c-pulse 2s ease-in-out infinite;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .b {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--line3);
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text3);
  }
  .b[hidden] {
    display: none;
  }
  .b:hover {
    border-color: var(--acc);
    color: var(--head);
  }
  .b:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }
  /* Entrances are for the home page; here the content is simply there. */
  .main :global(.c-pop) {
    animation: none;
  }
  /* Foldables in book posture (see index.astro): the page on one side of the fold and, on the other
     like the home page's sidebar, the header and the links after the page (the slot "end"), which
     stay in view as the page scrolls. */
  @media (horizontal-viewport-segments: 2) {
    .sp {
      display: grid;
      grid-template-columns: env(viewport-segment-width 0 0) env(viewport-segment-width 1 0);
      grid-template-rows: auto 1fr;
      column-gap: calc(env(viewport-segment-left 1 0) - env(viewport-segment-right 0 0));
      max-width: none;
      padding: 0;
      background: linear-gradient(to right, transparent env(viewport-segment-left 1 0), var(--panel) 0);
    }
    :global(:root[dir='rtl']) .sp {
      background: linear-gradient(to left, transparent env(viewport-segment-left 1 0), var(--panel) 0);
    }
    .main {
      grid-column: 1;
      grid-row: 1 / span 2;
      min-width: 0;
      padding: 28px 24px 72px;
    }
    .top,
    .end {
      grid-column: 2;
      box-sizing: border-box;
      padding-inline: 24px;
      border-inline-start: 1px solid var(--line2);
    }
    .top {
      grid-row: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      margin: 0;
      padding-top: 24px;
    }
    .end {
      position: sticky;
      top: 0;
      grid-row: 2;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      padding-block: 16px 24px;
    }
    /* Spacing meant for the foot of the page, not a panel. */
    .end > :global(:first-child) {
      margin-top: 0;
    }
  }
  @media print {
    .tools {
      display: none;
    }
  }
  @media (forced-colors: active) {
    .c-dot {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }
</style>
