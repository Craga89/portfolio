{
  "about": "Redirects from Craig's old domains to craigthompson.dev. tools/redirects.mjs turns this into a Cloudflare Bulk Redirects CSV and checks the live redirects. The craigsworks.com rules carry over what the old site's .htaccess files did (github.com/Craga89/craigsworks: projects/.htaccess, and projects/simpletip from github.com/Craga89/simpletip).",
  "home": "https://craigthompson.dev/",
  "domains": [
    "craigsworks.com",
    "craigs.works",
    "craigswork.com"
  ],
  "discoverSkip": [
    "/projects/forums/"
  ],
  "rules": [
    {
      "source": "craigsworks.com/projects/qtip2/forum",
      "target": "https://qtip2.com/",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "qTip2 forum pages (gone): qTip's site"
    },
    {
      "source": "craigsworks.com/projects/qtip2/forums",
      "target": "https://qtip2.com/",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "qTip2 forum pages (gone): qTip's site"
    },
    {
      "source": "craigsworks.com/projects/qtip/forum",
      "target": "https://qtip2.com/",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "the qTip 1 forum (about 6,800 archived URLs, gone): qTip's site"
    },
    {
      "source": "craigsworks.com/projects/qtip2docs",
      "target": "https://qtip2.com/docs",
      "subdomains": true,
      "subpath": true,
      "suffix": true,
      "why": "early qTip2 docs; the old .htaccess sent these to qtip2.com/docs/…"
    },
    {
      "source": "craigsworks.com/projects/qtip_new",
      "target": "https://qtip2.com/",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "the qTip2 beta (2009-10, about 320 archived URLs): qTip2's site"
    },
    {
      "source": "craigsworks.com/projects/qtip1",
      "target": "https://qtip1.com",
      "subdomains": true,
      "subpath": true,
      "suffix": true,
      "why": "qTip 1 under another name: qtip1.com"
    },
    {
      "source": "craigsworks.com/projects/qtip2",
      "target": "https://qtip2.com",
      "subdomains": true,
      "subpath": true,
      "suffix": true,
      "query": true,
      "why": "old .htaccess: projects/qtip2/* → qtip2.com/*"
    },
    {
      "source": "craigsworks.com/projects/qtip",
      "target": "https://qtip1.com",
      "subdomains": true,
      "subpath": true,
      "suffix": true,
      "query": true,
      "why": "old .htaccess: projects/qtip/* → qtip1.com/*"
    },
    {
      "source": "craigsworks.com/projects/forums",
      "target": "https://qtip2.com/",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "the old qTip support forums (2010-13, about 20,000 archived URLs, gone since): qTip's site and docs"
    },
    {
      "source": "craigsworks.com/projects/simpletip/download",
      "target": "https://cdn.jsdelivr.net/gh/Craga89/simpletip@master/download",
      "subdomains": true,
      "subpath": true,
      "suffix": true,
      "why": "Simpletip script files, still hot-linked by old sites: served from the GitHub repo through jsDelivr, as JavaScript"
    },
    {
      "source": "craigsworks.com/projects/simpletip",
      "target": "https://github.com/Craga89/simpletip",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "the Simpletip page (demos, docs, downloads) → its repository"
    },
    {
      "source": "craigsworks.com/projects",
      "target": "https://craigthompson.dev/#oss",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "old .htaccess sent /projects/ to the plugins section; now the open-source section"
    },
    {
      "source": "craigsworks.com/simpletip",
      "target": "https://github.com/Craga89/simpletip",
      "subdomains": true,
      "subpath": true,
      "suffix": false,
      "why": "Simpletip's first home (2009): its repository"
    },
    {
      "source": "craigsworks.com/cv.pdf",
      "target": "https://craigthompson.dev/cv.pdf",
      "subdomains": true,
      "why": "the old CV link"
    },
    {
      "source": "craigsworks.com/CV.pdf",
      "target": "https://craigthompson.dev/cv.pdf",
      "subdomains": true,
      "why": "the older CV link (capitalised, archived up to 2014)"
    },
    {
      "source": "craigsworks.com/",
      "target": "https://craigthompson.dev/",
      "subpath": true,
      "suffix": false,
      "subdomains": true,
      "why": "everything else on craigsworks.com, www and blog.craigsworks.com: the home page"
    },
    {
      "source": "craigs.works/",
      "target": "https://craigthompson.dev/",
      "subpath": true,
      "suffix": false,
      "subdomains": true,
      "why": "whole domain"
    },
    {
      "source": "craigswork.com/",
      "target": "https://craigthompson.dev/",
      "subpath": true,
      "suffix": false,
      "subdomains": true,
      "why": "whole domain"
    }
  ],
