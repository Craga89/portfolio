{
  "name": "craigthompson.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "node tools/lib/serve.mjs site",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc -p tsconfig.node.json && tsc -p tsconfig.worker.json",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"worker/src/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"tools/lib/**\" --test-coverage-lines=95 --test-coverage-branches=80 --test-coverage-functions=90 \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:a11y": "playwright test --project=a11y-desktop --project=a11y-mobile",
    "test:visual": "playwright test --project=visual",
    "test:smoke": "node --test \"tests/smoke/*.test.mjs\"",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:unit"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "astro": "7.4.2",
    "axe-core": "4.14.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "satteri": "0.11.5",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.15.0"
}
