// Pilot: the site served by Cloudflare Workers static assets, alongside GitHub Pages, while we find
// out whether to move (Craga89/standards guidelines/hosting.md). Deployed by
// .github/workflows/cloudflare.yml: main to the Worker's workers.dev address, every other branch to a
// Preview of its own. craigthompson.dev stays on GitHub Pages until the cutover.
//
// It's in its own folder so wrangler run from the repo root (tools/stats-report.mjs) doesn't pick it
// up. Paths are relative to this file.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Named after the repository.
  "name": "portfolio",
  "compatibility_date": "2026-10-13",
  // craigthompson.dev is served by this Worker (a custom domain). Listed here because each deploy
  // replaces the Worker's routes with these: without it, a deploy would detach the domain. The www
  // redirect is a Cloudflare redirect rule on the zone, not part of the Worker.
  "routes": [{ "pattern": "craigthompson.dev", "custom_domain": true }],
  // No copy at portfolio.craga89.workers.dev: craigthompson.dev is the site. Previews keep their own
  // addresses, which this doesn't affect.
  "workers_dev": false,
  // Previews keep their workers.dev addresses. Explicit: without it, turning workers_dev off turned
  // them off too.
  "preview_urls": true,
  "previews": {},
  "assets": {
    // The build output (pnpm run build), with cloudflare/_headers copied in by the workflow.
    "directory": "../site",
    // Astro writes every page as <path>/index.html; /path redirects to /path/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get site/404.html with a 404, as on GitHub Pages.
    "not_found_handling": "404-page",
  },
}
