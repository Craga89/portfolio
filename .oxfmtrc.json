{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "site/**",
    "tools/vendor/**",
    "worker/knowledge.json",
    "worker/agent-data.json",
    "pnpm-lock.yaml",
    "src/assets/fonts/**",
    "src/content/**",
    "src/data/**"
  ]
}
