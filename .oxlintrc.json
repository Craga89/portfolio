{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/.pnpm-config/@craga89/standards/configs/oxlint/astro.json"],
  "ignorePatterns": ["site/**", "tools/vendor/**"],
  "overrides": [
    {
      "files": ["src/**/*.js", "shared/**/*.js", "tools/translator-stub.mjs"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["tools/**/*.mjs", "worker/test/**", "tests/**"],
      "env": {
        "node": true
      },
      "rules": {
        "no-empty-pattern": "off"
      }
    },
    {
      "files": ["worker/src/**"],
      "env": {
        "worker": true
      }
    }
  ]
}
