{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsdoc", "node", "promise", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": { "es2024": true },
  "ignorePatterns": ["site/**", "tools/vendor/**"],
  "rules": {
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-console": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "prefer-const": "error",
    "no-var": "error",
    "import/no-cycle": "error",
    "jsdoc/check-tag-names": ["error", { "definedTags": ["satisfies"] }]
  },
  "overrides": [
    {
      "files": ["src/**/*.js", "shared/**/*.js", "tools/dc-runtime.js", "tools/translator-stub.mjs"],
      "env": { "browser": true }
    },
    { "files": ["tools/**/*.mjs", "worker/test/**", "tests/**"], "env": { "node": true } },
    { "files": ["worker/src/**"], "env": { "worker": true } }
  ]
}
